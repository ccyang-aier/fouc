# Comma-separated browser-only mock clients. Leave empty to use real services.
# Examples: dts | dts,github | *
NEXT_PUBLIC_FOUC_MOCKS=

# Knowledge infrastructure (local development).
# Generate unique local credentials with:
#   node backend/scripts/knowledge-infra.mjs init
# The generated .env.fouc.local is gitignored. Never commit that file.
# Start and verify the isolated stack with:
#   node backend/scripts/knowledge-infra.mjs up
#   node backend/scripts/knowledge-infra.mjs verify
# Windows uses Docker in this WSL distribution; Linux/macOS uses local Docker.
KNOWLEDGE_WSL_DISTRO=Ubuntu-22.04
FOUC_POSTGRES_USER=fouc_admin
FOUC_POSTGRES_DB=fouc
FOUC_POSTGRES_PASSWORD=
FOUC_DATABASE_APP_PASSWORD=
KNOWLEDGE_REDIS_PASSWORD=
# Runtime DATABASE_URL uses a non-superuser without BYPASSRLS.
DATABASE_URL=postgresql://fouc_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/fouc
# Database initialization only. Do not use this identity for API requests.
DATABASE_ADMIN_URL=postgresql://fouc_admin:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/fouc
REDIS_URL=redis://:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=fouc-knowledge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Fouc 全局服务 origin(Web 与桌面共用;桌面构建读取此值,不使用设备 sidecar)
NEXT_PUBLIC_FOUC_API_URL=http://127.0.0.1:8711
# Desktop verification emails land on the public Web deployment.
NEXT_PUBLIC_FOUC_WEB_URL=http://localhost:3000
FOUC_SERVICE_HOST=127.0.0.1
FOUC_SERVICE_PORT=8711

# 全局账户服务(可信 Web origin 需明确列出;生产使用 HTTPS)
BETTER_AUTH_URL=http://127.0.0.1:8711
BETTER_AUTH_SECRET=
FOUC_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FOUC_AUTH_COOKIE_MODE=same-site
# Desktop callbacks require the actual platform origin in trusted origins.
# Native HTTP keeps HttpOnly cookies in the WebView store; it is independent of browser third-party cookies.
# Example: append http://tauri.localhost for Windows desktop.
FOUC_AUTH_PROVIDERS=[]
