{
  "name": "@fouc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/entrypoints/server.ts",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env.fouc.local src/entrypoints/server.ts",
    "start": "bun src/entrypoints/server.ts",
    "typecheck": "tsc --noEmit",
    "models:catalog": "bun scripts/models-catalog.ts",
    "test": "bun test src",
    "build": "bun build --target=bun --packages=external ./src/entrypoints/server.ts --outdir dist"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@fouc/shared": "workspace:*",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.5",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "zod": "4.6.5",
    "@better-auth/utils": "0.4.2",
    "@hono/node-server": "2.1.1",
    "jose": "6.2.10",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
