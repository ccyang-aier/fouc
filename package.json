{
  "name": "fouc-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Fouc — a collaborative AI agent workbench for people and teams.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:all": "node scripts/dev.mjs",
    "build": "next build",
    "preview": "serve out",
    "typecheck": "tsc --noEmit",
    "i18n:verify": "node scripts/verify-i18n.mjs",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm typecheck && pnpm backend:typecheck && pnpm shared:typecheck && pnpm architecture:verify && pnpm docs:verify && pnpm dbx:verify && pnpm i18n:verify && pnpm lint && pnpm build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "backend:dev": "pnpm device:dev",
    "backend:start": "pnpm device:start",
    "backend:typecheck": "pnpm device:typecheck && pnpm server:typecheck",
    "shared:typecheck": "tsc --noEmit -p shared/tsconfig.json",
    "test:frontend": "bun test --isolate ./shared/src ./src",
    "dbx:verify": "node scripts/verify-dbx-migration-tracker.mjs",
    "datastore:cli": "bun backend/device/src/entrypoints/datastore-cli.ts",
    "datastore:mcp": "bun backend/device/src/entrypoints/datastore-mcp.ts",
    "docs:verify": "node scripts/verify-docs.mjs",
    "backend:test": "pnpm device:test && pnpm server:test",
    "verify:dts-live": "bun backend/device/scripts/verify-dts-live.ts",
    "backend:build": "node scripts/build-backend.mjs",
    "verify:approval": "bun backend/device/scripts/verify-approval.ts",
    "verify:dbx-catalog": "bun scripts/verify-dbx-catalog.ts",
    "device:dev": "bun --watch backend/device/src/entrypoints/index.ts",
    "device:start": "bun backend/device/src/entrypoints/index.ts",
    "device:typecheck": "pnpm --filter @fouc/device typecheck",
    "device:test": "pnpm --filter @fouc/device test",
    "device:build": "pnpm --filter @fouc/device build",
    "server:dev": "bun --watch --env-file=.env.fouc.local backend/server/src/entrypoints/server.ts",
    "server:start": "bun backend/server/src/entrypoints/server.ts",
    "server:typecheck": "pnpm --filter @fouc/server typecheck",
    "server:test": "pnpm --filter @fouc/server test",
    "server:build": "pnpm --filter @fouc/server build",
    "architecture:verify": "node scripts/verify-architecture.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fouc/shared": "workspace:*",
    "@lezer/highlight": "1.2.4",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@tanstack/react-query": "5.104.0",
    "@tauri-apps/api": "2.11.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "class-variance-authority": "latest",
    "client-only": "0.0.1",
    "clsx": "latest",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.55.0",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "sql-formatter": "15.8.0",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.14.5",
    "postcss": "latest",
    "serve": "latest",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "latest",
    "typescript": "5.9.3"
  },
  "pnpm": {}
}
