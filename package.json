{
  "name": "fouc-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Fouc — a collaborative AI agent workbench for people and teams.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "preview": "serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "backend:dev": "bun --hot backend/src/index.ts",
    "backend:start": "bun backend/src/index.ts",
    "backend:typecheck": "tsc --noEmit -p backend/tsconfig.json",
    "shared:typecheck": "tsc --noEmit -p shared/tsconfig.json",
    "knowledge:verify": "node scripts/verify-knowledge-tasks.mjs && node scripts/verify-knowledge-boundaries.mjs",
    "knowledge:test": "bun test shared/src/knowledge backend/src/knowledge",
    "backend:test": "bun --cwd backend test",
    "verify:dts-live": "bun backend/scripts/verify-dts-live.ts",
    "backend:build": "node scripts/build-backend.mjs",
    "verify:approval": "bun backend/scripts/verify-approval.ts",
    "verify:dbx-catalog": "bun scripts/verify-dbx-catalog.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fouc/shared": "workspace:*",
    "@hocuspocus/provider": "4.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@tanstack/react-query": "5.104.0",
    "@tauri-apps/api": "2.11.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@trpc/client": "11.19.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "latest",
    "y-indexeddb": "9.0.12",
    "y-prosemirror": "1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.14.5",
    "lib0": "^0.2.118",
    "postcss": "latest",
    "serve": "latest",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "latest",
    "typescript": "5.9.3"
  },
  "pnpm": {}
}
