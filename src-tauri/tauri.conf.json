{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fouc",
  "version": "0.1.0",
  "identifier": "com.fouc.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/build-backend.mjs && pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fouc",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AI Agent collaborative workbench",
    "longDescription": "Fouc brings people, teams, and AI agents into one shared workflow.",
    "externalBin": [
      "binaries/fouc-backend",
      "binaries/fouc-native-node"
    ],
    "resources": {
      "../backend/device/src/agents/project-native-worker.cjs": "native-execution/project-native-worker.cjs",
      "binaries/fouc-native-node.LICENSE": "native-execution/node.LICENSE"
    }
  }
}
